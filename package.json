{
  "name": "rwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "verify": "node scripts/verify-build.mjs",
    "start": "node --max-http-header-size=65536 node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/resolver.mjs --test \"test/**/*.test.ts\"",
    "backfill:universe": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-universe.ts",
    "backfill:images": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-images.ts",
    "backfill:image-cdn": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-image-cdn.ts",
    "verify:chain": "node --import ./test/resolver.mjs --env-file=.env.local scripts/verify-chain.ts",
    "forge:test": "forge test --root contracts --no-match-contract HodlRouterFork",
    "forge:test:fork": "forge test --root contracts --match-contract HodlRouterFork",
    "forge:coverage": "forge coverage --root contracts --no-match-contract HodlRouterFork",
    "backfill:pools": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-pools.ts",
    "audit:charts": "node --import ./test/resolver.mjs --env-file=.env.local scripts/audit-chart-inversion.ts",
    "backfill:eligible": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-eligible.ts",
    "hide:fake-longs": "node --import ./test/resolver.mjs --env-file=.env.local scripts/hide-fake-longs.ts",
    "backfill:prices": "node --import ./test/resolver.mjs --env-file=.env.local scripts/backfill-prices.ts",
    "worker": "node --import ./test/resolver.mjs src/worker/index.ts",
    "cron:railway": "node --import ./test/resolver.mjs scripts/railway-cron.ts",
    "vapid": "node --import ./test/resolver.mjs scripts/vapid-keys.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-org/account": "^2.5.10",
    "@coinbase/wallet-sdk": "^4.3.7",
    "@privy-io/react-auth": "^3.37.1",
    "@privy-io/server-auth": "^1.32.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.101.4",
    "lightweight-charts": "^5.2.1",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4",
    "viem": "^2.55.17",
    "wagmi": "^3.7.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
