# Canonical app origin (metadata, OG, share links). Production: https://hodl.fan
# NEXT_PUBLIC_APP_URL=https://hodl.fan

# Privy — the landing page is a Privy login, same as Pick.
# Leave unset to run in demo mode (login is faked in this browser).
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect / Reown project id, for importing an external wallet.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Platform fee. Flat 50 bps. No floor. $1 dust guard lives in HodlRouter.
NEXT_PUBLIC_FEE_BPS=50

# Live HodlRouter ticket. LIVE_TRADE=1 plus a router opens Buy/Sell for
# every signed-in wallet. Leave WALLETS empty for everyone; set it only
# to restrict to specific addresses.
# NEXT_PUBLIC_LIVE_TRADE=1
# NEXT_PUBLIC_HODL_ROUTER=
# NEXT_PUBLIC_FEE_COLLECTOR=
# NEXT_PUBLIC_LIVE_TRADE_WALLETS=

# CoinGecko / GeckoTerminal onchain API.
# Optional: without it the app uses the free GeckoTerminal endpoint at roughly
# 30 calls a minute, which makes the trades tape refresh every 12s instead of 4s.
# Set COINGECKO_API_PLAN=demo for a Demo key; paid keys need no plan setting.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=

# Some publishers (Yahoo especially) send response headers larger than Node's
# 16KB default, which makes fetch throw outright and costs the news feed its
# article images. The dev/start scripts raise it locally; on a host that runs
# `next start` itself, set this instead:
# NODE_OPTIONS=--max-http-header-size=65536

# Supabase — the token universe, profiles, comments, follows, rewards.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Cron secret for /api/cron/index-tokens and /api/cron/rewards.
# CRON_SECRET=

# Trending tab floors and momentum weights (optional).
# TRENDING_MIN_MARKET_CAP_USD=50000
# TRENDING_MIN_LIQUIDITY_USD=5000
# TRENDING_WEIGHT_1H=1
# TRENDING_WEIGHT_6H=0.35
# TRENDING_WEIGHT_24H=0.15
# TRENDING_WASH_MIN_TXNS_1H=4

# Skip DexScreener during image/social resolve (launchpad socials still store).
# Default on in development. Set 0 to force Dex locally.
# SKIP_DEXSCREENER=1

# Shared cache (optional). Add "Upstash for Redis" from the Vercel Marketplace
# and it injects these automatically; with them set, a cold instance reads the
# built feed from Redis instead of spending several seconds rebuilding it.
# Without them the app falls back to its in-process cache and still works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
