# Privy — the landing page is a Privy login, same as Pick.
# Leave unset to run in demo mode (login is faked in this browser).
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect / Reown project id, for importing an external wallet.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Platform fee. Matched to FOMO: half a percent with a flat floor, so small
# trades break even instead of costing more to serve than they earn.
NEXT_PUBLIC_FEE_BPS=50
NEXT_PUBLIC_FEE_MIN_USD=0.95
