# HODL environment variables
#
# Copy to .env.local:   cp .env.local.example .env.local
# The npm scripts that run outside Next (backfill:*, verify:chain, …) load
# .env.local with `node --env-file`, which fails if the file is missing, so
# create it even if you leave everything blank.
#
# Every variable the code reads is listed here. Nothing below is a real value.
#   [required]  the feature named next to it does not work without it
#   [optional]  has a working default or degrades gracefully
#
# Leave optional lines COMMENTED OUT rather than setting them to an empty
# value. Some readers treat an empty string as 0: an uncommented
# `NEXT_PUBLIC_FEE_BPS=` shows a 0% fee in the UI.
#
# With nothing set, `npm run dev` still starts: login is faked in the
# browser, token lists are empty ("Token store is not configured"), RWA
# prices and news still load from public sources.


# ─── App ────────────────────────────────────────────────────────────────────

# [optional] Canonical origin for metadata, OG images, share links and push.
# Production uses the live domain; locally it falls back to VERCEL_URL or
# http://localhost:3000.
# NEXT_PUBLIC_APP_URL=

# [optional] Seeded demo people, comments and market data. Only used when
# Supabase is NOT configured. Off by default so a deploy that is missing its
# database says "data unavailable" instead of inventing people.
# DEMO_MODE=1

# [optional] Raise Node's 16KB response-header limit (some news publishers send
# larger headers). `npm run dev` / `npm start` already pass this flag; set it
# only on a host that runs `next start` itself.
# NODE_OPTIONS=--max-http-header-size=65536


# ─── Auth and wallets ───────────────────────────────────────────────────────

# [required for real login] Privy app id. Where: dashboard.privy.io → your
# app → Settings → App ID. Unset = demo login, faked in this browser.
NEXT_PUBLIC_PRIVY_APP_ID=

# [required for real login] Privy app secret, used server-side to verify the
# caller's Privy token on every /api/me/* route and on trade notifications.
# Where: dashboard.privy.io → Settings → API keys. Server only, never NEXT_PUBLIC.
# PRIVY_APP_SECRET=

# [optional] WalletConnect / Reown project id, for importing an external
# wallet. Where: cloud.reown.com → create a project → Project ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=


# ─── Trading (HodlRouter) ───────────────────────────────────────────────────

# [required for live trading] Master switch. 1 opens Buy / Sell for signed-in
# wallets; anything else keeps the trade box closed.
# NEXT_PUBLIC_LIVE_TRADE=1

# [optional] Comma-separated wallet allow-list. Empty or unset = every wallet.
# NEXT_PUBLIC_LIVE_TRADE_WALLETS=

# [required for live trading] Router and collector addresses. If unset, the app
# falls back to the v1 pair in src/lib/contracts.ts, and v1 is PAUSED. Set
# both to the v2 addresses in README.md → Smart contracts. Always set them
# together.
# NEXT_PUBLIC_HODL_ROUTER=
# NEXT_PUBLIC_FEE_COLLECTOR=

# [optional] Fee shown in the UI, in basis points. Default 50 (0.5%), which
# matches the router. Do not set it to an empty value (see the note at the top).
# NEXT_PUBLIC_FEE_BPS=

# [optional] Liquidity floor (USD) for showing a token as tradeable. Default 500.
# NEXT_PUBLIC_MIN_LIQUIDITY_USD=


# ─── Supabase (token universe, profiles, comments, follows, portfolio) ──────

# [required for any stored data] Where: supabase.com → your project →
# Project Settings → API. Run the schema files first (README.md → Database).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [required for any stored data] Service-role key. Server only: it bypasses
# row-level security. Where: same page, "service_role" secret.
# SUPABASE_SERVICE_ROLE_KEY=

# [required for the worker and the admin scripts] Direct Postgres connection
# (port 5432, not the 6543 transaction pooler). Where: Supabase → Connect →
# "Direct connection" or "Session pooler". Percent-encode / @ # in the password.
# DATABASE_URL=


# ─── Robinhood Chain RPC (4663) ─────────────────────────────────────────────
# All optional: without them the server uses the public Robinhood Chain RPC,
# which is rate-limited and keeps only about 20 minutes of state.

# [optional, recommended in production] Primary HTTP RPC. Also the `rh` fork
# endpoint in contracts/foundry.toml. Where: dashboard.alchemy.com → create an
# app on Robinhood Chain → HTTPS URL.
# ALCHEMY_RPC_URL=

# [optional] WebSocket for the live-tip worker. If unset it is derived from
# ALCHEMY_RPC_URL; with neither WSS set, the worker polls instead.
# ALCHEMY_WSS_URL=

# [optional] Fallback RPC. Where: console.chainstack.com → Robinhood Chain node.
# CHAINSTACK_RPC_URL=
# CHAINSTACK_WSS_URL=

# [optional] Override the RPC for the testnet chain definition.
# NEXT_PUBLIC_RH_TESTNET_RPC=


# ─── Cron and the Railway services ──────────────────────────────────────────

# [required for cron] Bearer secret for every /api/cron/* route. Any long
# random string (e.g. `openssl rand -hex 32`). Must be the same value on Vercel
# and on the Railway cron service.
# CRON_SECRET=

# [required on the Railway cron service] Origin the cron runner calls, no
# trailing slash. Read in this order: CRON_ORIGIN, VERCEL_APP_URL, APP_URL.
# CRON_ORIGIN=
# VERCEL_APP_URL=
# APP_URL=

# [optional] Per-job timeout for the Railway cron runner. Default 90000 (minimum 60000).
# CRON_JOB_TIMEOUT_MS=


# ─── Shared cache (Redis) ───────────────────────────────────────────────────

# [optional] Upstash Redis REST credentials. With them, a cold instance reads
# the built feed from Redis instead of rebuilding it. Without them the app uses
# an in-process cache. Where: Vercel Marketplace → "Upstash for Redis" injects
# KV_*; or console.upstash.com → database → REST API (UPSTASH_*). Set one pair.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ─── Market data and news ───────────────────────────────────────────────────

# [optional] CoinGecko / GeckoTerminal on-chain API. Without a key the free
# endpoint allows ~30 calls/min, so the trades tape refreshes every 12s instead
# of every 4s. Where: coingecko.com/en/api → Developer dashboard.
# Set COINGECKO_API_PLAN=demo for a Demo key; paid keys need no plan.
# COINGECKO_API_KEY=
# COINGECKO_API_PLAN=

# [optional] Finnhub key for the news wire. Unset = the wire is skipped.
# Where: finnhub.io → Dashboard → API key.
# NEWS_API_KEY=

# [optional] X (Twitter) API v2 bearer token for social lookups.
# Where: developer.x.com → Projects & Apps → Keys and tokens → Bearer Token.
# X_BEARER_TOKEN=

# [optional] Skip DexScreener while resolving images and socials (launchpad
# socials are still stored). On by default in development; 0 forces Dex locally.
# SKIP_DEXSCREENER=1


# ─── Trending tuning (all optional, defaults in src/config/trending.ts) ─────

# TRENDING_MIN_MARKET_CAP_USD=
# TRENDING_MIN_LIQUIDITY_USD=
# TRENDING_WEIGHT_1H=
# TRENDING_WEIGHT_6H=
# TRENDING_WEIGHT_24H=
# TRENDING_MIN_BASELINE_HOURLY_USD=
# TRENDING_MIN_BASELINE_24H_USD=
# TRENDING_BUYER_BOOST=
# TRENDING_PRICE_BOOST=
# TRENDING_WASH_MIN_VOLUME_USD=
# TRENDING_WASH_MIN_TXNS_1H=
# TRENDING_WASH_MIN_BUYS_1H=
# TRENDING_WASH_LOW_TXN_PENALTY=
# TRENDING_WASH_MAX_AVG_TRADE_USD=
# TRENDING_WASH_WHALE_PENALTY=
# TRENDING_WASH_EXCLUDE_BELOW=


# ─── Web push (optional) ────────────────────────────────────────────────────

# Generate a pair with `npm run vapid`. Unset = push notifications are off.
# The private key is server only.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=


# ─── Scripts and debugging (optional) ───────────────────────────────────────

# Page size for keyset batch jobs (default 500, clamped). backfill:prices
# prefers PRICE_BACKFILL_PAGE.
# BATCH_PAGE=
# PRICE_BACKFILL_PAGE=

# Log on-chain price resolution details.
# PRICE_DEBUG=1

# TypeScript fork harness (scripts/fork/harness.ts). Defaults to a local anvil
# at http://127.0.0.1:8545 and anvil's well-known test key #0.
# FORK_RPC_URL=
# ANVIL_PRIVATE_KEY=

# Build output dir for `npm run verify` (set by the script itself).
# BUILD_DIR=

# Base URL for the palette screenshot script.
# PALETTE_BASE_URL=

# Set by the platform, never by hand: NODE_ENV, VERCEL_URL,
# RAILWAY_ENVIRONMENT, RAILWAY_REPLICA_ID, RAILWAY_SERVICE_NAME.
